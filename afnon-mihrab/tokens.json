{
  "$description": "Afnon · Mihrab design tokens: the one source for the app (Tokens.java, colors.xml) and the preview site (tokens.css). Values in px for a 1920×1080 TV viewed at ~3 m. Edit here, then run `npm run tokens` in site/. $extensions.tv.afnon.java names the Java constant when it differs from the path. Night mode's colours are tokens.night.json, which overrides colours of this file by the same paths.",
  "color": {
    "lapis-950": { "$type": "color", "$value": "#0A1730", "$description": "Settings sidebar, below the ground" },
    "lapis-900": { "$type": "color", "$value": "#0C1B33", "$description": "Ground / page background" },
    "lapis-800": { "$type": "color", "$value": "#12264A", "$description": "Surface: arch fill, tiles, cells, panels" },
    "lapis-700": { "$type": "color", "$value": "#1A3360", "$description": "Raised: badges, stepper buttons, toggle off track" },
    "gold-400": { "$type": "color", "$value": "#D8B46A", "$description": "Accent, sacred text, focus fill, next prayer · 8.9:1 on ground" },
    "gold-200": { "$type": "color", "$value": "#F0D79C", "$description": "Approaching-prayer glow, pressed state" },
    "plaster-100": { "$type": "color", "$value": "#EFE7D6", "$description": "Primary text, focus ring, current prayer · 13.9:1 on ground" },
    "mist-400": { "$type": "color", "$value": "#9FB0CC", "$description": "Secondary text, past prayers · 7.7:1 on ground" },
    "disabled-text": { "$type": "color", "$value": "#6F7F9C" },
    "lapis-800-60": { "$type": "color", "$value": "rgba(18,38,74,0.6)", "$description": "Past prayer cells (lapis-800 at 60%)" },
    "gold-400-60": { "$type": "color", "$value": "rgba(216,180,106,0.6)", "$description": "Arch foot button border at rest" },
    "line-soft": { "$type": "color", "$value": "rgba(239,231,214,0.25)", "$description": "Chip borders, Qibla outer ring" },
    "line-dash": { "$type": "color", "$value": "rgba(239,231,214,0.3)", "$description": "Dashed \"All apps\" border" },
    "arch-inner": { "$type": "color", "$value": "rgba(216,180,106,0.45)", "$description": "Inner arch line" },
    "bell-off-border": { "$type": "color", "$value": "rgba(159,176,204,0.4)", "$description": "Prayer Day: reminder bell when off (mist-400 at 40%)" },
    "banner-track": { "$type": "color", "$value": "rgba(216,180,106,0.25)", "$description": "Reminder banner: time-left track (gold-400 at 25%)" },
    "seg-track-focused": { "$type": "color", "$value": "rgba(12,27,51,0.15)", "$description": "Settings: segmented control track on a focused gold row (lapis-900 at 15%)" },
    "qibla-ring": { "$type": "color", "$value": "rgba(239,231,214,0.1)", "$description": "Qibla inner ring (plaster-100 at 10%)" },
    "qibla-tick": { "$type": "color", "$value": "rgba(239,231,214,0.5)", "$description": "Qibla cardinal ticks (plaster-100 at 50%)" },
    "scrim": { "$type": "color", "$value": "rgba(8,18,36,0.94)", "$description": "Prayer-time-now overlay (no blur)" },
    "scrim-menu": { "$type": "color", "$value": "rgba(12,27,51,0.92)", "$description": "Behind menus, pickers and choosers (lapis-900 at 92%)" },
    "scrim-panel": { "$type": "color", "$value": "rgba(6,13,26,0.72)", "$description": "Behind side panels (Inputs)" },
    "pattern-line": { "$type": "color", "$value": "rgba(216,180,106,0.07)", "$description": "Star lattice lines (gold-400 at 7%)" },
    "on-plaster": {
      "label": { "$type": "color", "$value": "#5A4A22", "$description": "Approaching card: caps label on plaster" },
      "secondary": { "$type": "color", "$value": "#3D4A63", "$description": "Approaching card: secondary text on plaster" },
      "border": { "$type": "color", "$value": "rgba(12,27,51,0.6)", "$description": "Approaching card border (lapis-900 at 60%)" },
      "button-border": { "$type": "color", "$value": "rgba(12,27,51,0.35)", "$description": "Approaching card: outlined button border (lapis-900 at 35%)" }
    },
    "card": {
      "fill": { "$type": "color", "$value": "{color.plaster-100}", "$description": "Approaching card (Home's reminder) ground" },
      "text": { "$type": "color", "$value": "{color.lapis-900}", "$description": "Approaching card: title and outlined button label" }
    },
    "current": {
      "fill": { "$type": "color", "$value": "{color.plaster-100}", "$description": "The current prayer (Home's cell, Prayer day's row) and a chosen segment" },
      "text": { "$type": "color", "$value": "{color.lapis-900}", "$description": "Text and icons on current.fill" }
    },
    "screensaver": {
      "ground": { "$type": "color", "$value": "#000000", "$description": "Screensaver and Audio Only ground" },
      "text": { "$type": "color", "$value": "#A69F90" },
      "text-dim": { "$type": "color", "$value": "#7D7769" },
      "next": { "$type": "color", "$value": "#B8A578" },
      "arch-line": { "$type": "color", "$value": "rgba(216,180,106,0.35)" }
    }
  },
  "font": {
    "family": {
      "display-en": { "$type": "fontFamily", "$value": ["Marcellus", "serif"] },
      "display-ar": { "$type": "fontFamily", "$value": ["Amiri", "serif"], "$description": "Weight 700" },
      "sacred": { "$type": "fontFamily", "$value": ["Amiri", "serif"], "$description": "Weight 400, gold-400, never bold or letter-spaced" },
      "ui": { "$type": "fontFamily", "$value": ["Alexandria", "sans-serif"], "$description": "Weights 300–600; Arabic + Latin + Eastern Arabic digits" }
    },
    "size": {
      "display-xl": { "$type": "dimension", "$value": "150px", "$description": "Countdown" },
      "display-xl-hours": { "$type": "dimension", "$value": "120px", "$description": "Countdown when it has hours" },
      "display-l": { "$type": "dimension", "$value": "96px", "$description": "Clock" },
      "display-m": { "$type": "dimension", "$value": "88px", "$description": "Next prayer name" },
      "display-s": { "$type": "dimension", "$value": "44px", "$description": "Settings chooser title" },
      "display-xs": { "$type": "dimension", "$value": "36px", "$description": "Settings Asr preview time" },
      "title-l": { "$type": "dimension", "$value": "64px" },
      "title": { "$type": "dimension", "$value": "52px" },
      "heading": { "$type": "dimension", "$value": "40px" },
      "body-l": { "$type": "dimension", "$value": "30px" },
      "body": { "$type": "dimension", "$value": "26px" },
      "label": { "$type": "dimension", "$value": "22px" },
      "caption": { "$type": "dimension", "$value": "20px", "$description": "Minimum size on screen" },
      "sacred": { "$type": "dimension", "$value": "32px" }
    },
    "lineHeight": {
      "display": { "$type": "number", "$value": 1 },
      "title": { "$type": "number", "$value": 1.15 },
      "body": { "$type": "number", "$value": 1.5 },
      "sacred": { "$type": "number", "$value": 1.55 }
    },
    "letterSpacing": {
      "caps-en": { "$type": "dimension", "$value": "0.2em", "$description": "English caps labels only" },
      "ar": { "$type": "dimension", "$value": "0em", "$description": "Arabic is never letter-spaced" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "8px" },
    "2": { "$type": "dimension", "$value": "12px" },
    "3": { "$type": "dimension", "$value": "16px" },
    "4": { "$type": "dimension", "$value": "24px" },
    "5": { "$type": "dimension", "$value": "32px" },
    "6": { "$type": "dimension", "$value": "48px" },
    "7": { "$type": "dimension", "$value": "64px" },
    "8": { "$type": "dimension", "$value": "96px" },
    "safe-inline": { "$type": "dimension", "$value": "96px" },
    "safe-block": { "$type": "dimension", "$value": "56px" }
  },
  "layout": {
    "$type": "dimension",
    "arch": {
      "width": { "$value": "600px", "$extensions": { "tv.afnon": { "java": "ARCH_W" } } },
      "height": { "$value": "900px", "$extensions": { "tv.afnon": { "java": "ARCH_H" } } },
      "inset-inline-start": { "$value": "96px", "$extensions": { "tv.afnon": { "java": "ARCH_X" } } },
      "top": { "$value": "120px", "$extensions": { "tv.afnon": { "java": "ARCH_Y" } } },
      "crown-height": { "$value": "380px" }
    },
    "courtyard": {
      "inset-inline-start": { "$value": "760px", "$extensions": { "tv.afnon": { "java": "COURT_X" } } },
      "width": { "$value": "1064px", "$extensions": { "tv.afnon": { "java": "COURT_W" } } }
    },
    "gap-favourites": { "$value": "24px" },
    "gap-more": { "$value": "20px" },
    "gap-prayer-cells": { "$value": "12px" },
    "tile-favourite": { "width": { "$value": "248px" }, "height": { "$value": "150px" } },
    "tile-more": { "height": { "$value": "112px" } },
    "prayer-cell": { "height": { "$value": "146px" } },
    "day-row": { "width": { "$value": "620px" }, "height": { "$value": "104px" } },
    "button-height": { "$value": "72px" },
    "toast-width": { "$value": "680px" },
    "banner-width": { "$value": "640px" },
    "side-panel-width": { "$value": "600px" },
    "settings": {
      "sidebar-width": { "$value": "560px" },
      "row-width": { "$value": "1184px" }
    }
  },
  "radius": {
    "badge": { "$type": "dimension", "$value": "8px" },
    "cell": { "$type": "dimension", "$value": "14px" },
    "row": { "$type": "dimension", "$value": "16px" },
    "tile": { "$type": "dimension", "$value": "18px" },
    "panel": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "focus": {
    "fill": { "$type": "color", "$value": "{color.gold-400}", "$description": "A focused tile, row or button" },
    "text": { "$type": "color", "$value": "{color.lapis-900}", "$description": "Text and icons on focus.fill" },
    "ring-color": { "$type": "color", "$value": "{color.plaster-100}", "$description": "The ring round a focused tile" },
    "ring-width": { "$type": "dimension", "$value": "4px" },
    "ring-offset": { "$type": "dimension", "$value": "6px" },
    "scale": { "$type": "number", "$value": 1.06 },
    "scale-row": { "$type": "number", "$value": 1.04 },
    "scale-settings-row": { "$type": "number", "$value": 1.02, "$description": "Settings rows, which are wide" },
    "on-light": {
      "fill": { "$type": "color", "$value": "{color.lapis-900}" },
      "text": { "$type": "color", "$value": "{color.plaster-100}" },
      "ring-color": { "$type": "color", "$value": "{color.gold-400}" },
      "ring-offset": { "$type": "dimension", "$value": "4px" }
    },
    "pressed": {
      "fill": { "$type": "color", "$value": "{color.gold-200}" },
      "scale": { "$type": "number", "$value": 1.02 },
      "ring-offset": { "$type": "dimension", "$value": "4px" }
    }
  },
  "border": {
    "arch-rest": { "color": { "$type": "color", "$value": "{color.gold-400}" }, "width": { "$type": "dimension", "$value": "3px" } },
    "arch-focused": { "color": { "$type": "color", "$value": "{color.plaster-100}" }, "width": { "$type": "dimension", "$value": "5px" } },
    "arch-approaching": { "color": { "$type": "color", "$value": "{color.gold-200}" }, "width": { "$type": "dimension", "$value": "6px" } },
    "next-prayer": { "$description": "Drawn inset", "color": { "$type": "color", "$value": "{color.gold-400}" }, "width": { "$type": "dimension", "$value": "3px" } },
    "chip": { "color": { "$type": "color", "$value": "{color.line-soft}" }, "width": { "$type": "dimension", "$value": "2px" } }
  },
  "motion": {
    "$description": "Animate transform and opacity only. No blur, no video, no shadow larger than a solid 6px ring.",
    "easing-standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "focus": { "$type": "duration", "$value": "120ms", "$extensions": { "tv.afnon": { "java": "DUR_FOCUS_MS" } } },
    "panel-slide": { "$type": "duration", "$value": "240ms" },
    "overlay-fade": { "$type": "duration", "$value": "200ms", "$description": "linear" },
    "screensaver-fade": { "$type": "duration", "$value": "800ms", "$description": "As AfnonDream.FADE_MS" },
    "screensaver-drift-interval": { "$type": "duration", "$value": "60s" },
    "banner-lifetime": { "$type": "duration", "$value": "12s" },
    "saved-lifetime": { "$type": "duration", "$value": "2s", "$description": "Settings: how long ✓ Saved shows after a change" },
    "call-auto-dismiss": { "$type": "duration", "$value": "10min", "$description": "The call screen closes by itself: the default of Settings → Reminders → Close the call screen" },
    "call-silent-dismiss": { "$type": "duration", "$value": "60s", "$description": "The call screen set to close when the adhan ends, with no adhan playing" }
  },
  "timing": {
    "approach": {
      "$type": "duration", "$value": "15min",
      "$description": "Before a prayer, the arch switches to its approaching outline",
      "$extensions": { "tv.afnon": { "java": "APPROACH_MIN", "unit": "min" } }
    }
  }
}
