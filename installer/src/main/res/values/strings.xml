    <string name="guide_title">Afnon on your TV</string>
    <string name="guide_lead">Install Afnon from this phone in a few minutes, no computer needed. First, four steps on the TV with its remote.</string>
    <string name="g1_title">Open About</string>
    <string name="g2_title">Become a developer</string>
    <string name="g2_body">Press OK on it 7 times, until the TV says you are now a developer.</string>
    <string name="g3_title">Turn on debugging</string>
    <string name="g3_body">Turn this on. Some TVs call it ADB or Network debugging:</string>
    <string name="g4_title">Same Wi-Fi</string>
    <string name="g4_body">Keep the TV and this phone on the same Wi-Fi network.</string>
    <string name="guide_ready">Find my TV</string>

