---
// All apps (AllAppsActivity): back, title and count, the next-prayer chip, a 5-column grid of apps with the
// favourites starred, the info bar (focused app and key hints), and the hold-OK menu to arrange favourites.
import Icon from '../components/Icon.astro';
import type { Ctx } from '../lib/ctx';
import { href } from '../lib/site';
import { APPS, FAVS, appsModel, favNote } from './apps';

interface Props { ctx: Ctx }
const { ctx } = Astro.props;
const { t, lang } = ctx;
const m = appsModel(ctx);
const COLS = 5, GAP = 32, TILE_H = 168, TOP = 200;
const W = (1728 - (COLS - 1) * GAP) / COLS;
const apps = APPS.map((a, i) => ({ name: a[lang], icon: a.icon, fav: i < FAVS ? i + 1 : 0 }));
const favNames = apps.slice(0, FAVS).map((a) => a.name);
const site = t.ar ? 'على التلفاز يفتح هذا' : 'On the TV this opens';
const menuText = {
  earlier: t.s('moveEarlier'), later: t.s('moveLater'), cancel: t.s('cancel'),
  instead: favNames.map((n) => t.s('putInPlaceOf', { app: n })),
  done: t.ar ? 'على التلفاز يُحفظ هذا الترتيب' : 'On the TV this arranges your favourites',
};
---
<a class="ft back" href={href('', lang) + '#tv'} aria-label={t.s('back')} data-home data-name={t.s('back')} data-note={t.s('hintBackHome')}>
  <Icon name="back" size={32} stroke={2} />
</a>
<div class="head">
  <h2 class="title display-bold">{t.s('allTitle')}</h2>
  <span class="count">{t.d(apps.length)}</span>
</div>
<a class="ft chip" href={href('prayer-day', lang) + '#tv'} data-name={t.s('today')} data-note={t.hintOk(t.s('today'))}>
  <Icon name="mihrab" size={26} stroke={2} />
  <span class="chip-label" data-k="chipLabel" set:html={m.html.chipLabel} />
  <span class="chip-time display num" dir="ltr" data-k="chipTime" set:html={m.html.chipTime} />
</a>

{apps.map((a, i) => (
  <button class="ft tile" data-app={i} data-fav={a.fav} data-name={a.name} data-note={a.fav ? favNote(t, a.fav) : t.s('notFav')}
    {...(i === 0 ? { 'data-focus-start': '' } : {})} data-toast={`${site} ${a.name}`}
    style={`inset-inline-start:${96 + (i % COLS) * (W + GAP)}px;top:${TOP + Math.floor(i / COLS) * (TILE_H + GAP)}px;width:${W}px`}>
    <span class="top">
      <span class="mono"><Icon name={a.icon} size={32} /></span>
      {a.fav ? <span class="star" aria-label={t.s('favourite')}><Icon name="star" size={26} /></span> : null}
    </span>
    <span class="label">{a.name}</span>
  </button>
))}

<div class="bar">
  <div class="who">
    <div class="who-name" data-info-name>{apps[0].name}</div>
    <div class="who-note" data-info-note>{favNote(t, 1)}</div>
  </div>
  <div class="keys">
    <span>{t.s('hintOpen')}</span><span>{t.s('hintHold')}</span><span>{t.s('hintBackHome')}</span>
  </div>
</div>

<!-- Hold OK: arrange favourites (AllAppsActivity.openMenu). Items are filled in by the script. -->
<div class="menu" data-menu hidden data-text={JSON.stringify(menuText)}>
  <div class="menu-card">
    <div class="menu-title display-bold" data-menu-title></div>
    <div class="menu-items" data-menu-items></div>
  </div>
</div>

<div class="toast" data-toast-out hidden role="status"></div>

<script>
  import { live } from '../scripts/live';
  import { appsModel } from './apps';

  const stage = document.querySelector<HTMLElement>('.tv')!;
  if (stage.dataset.screen === 'apps') {
    live(appsModel);

    const $ = <T extends HTMLElement = HTMLElement>(s: string) => stage.querySelector<T>(s)!;
    const name = $('[data-info-name]'), note = $('[data-info-note]');
    stage.addEventListener('focusin', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-name]');
      if (!el || !el.dataset.note) return;
      name.textContent = el.dataset.name!;
      name.dir = /^[\x00-\x7F]*$/.test(el.dataset.name!) ? 'ltr' : 'rtl';
      note.textContent = el.dataset.note;
    });

    const toast = $('[data-toast-out]');
    let toastTimer = 0;
    const say = (text: string) => {
      toast.textContent = text;
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => (toast.hidden = true), 2600);
    };

    // The menu: for a favourite, move earlier/later; otherwise put it in place of one; always cancel.
    const menu = $('[data-menu]');
    const text = JSON.parse(menu.dataset.text!);
    let from: HTMLElement | null = null;
    const closeMenu = () => { menu.hidden = true; from?.focus({ preventScroll: true }); };
    const openMenu = (tile: HTMLElement) => {
      from = tile;
      const fav = Number(tile.dataset.fav);
      const items: string[] = [];
      if (fav > 1) items.push(text.earlier);
      if (fav && fav < 4) items.push(text.later);
      if (!fav) items.push(...text.instead);
      $('[data-menu-title]').textContent = tile.dataset.name!;
      $('[data-menu-items]').replaceChildren(...[...items, text.cancel].map((label, i, all) => {
        const b = document.createElement('button');
        b.className = 'ft row item';
        b.textContent = label;
        if (i === all.length - 1) b.dataset.back = '';
        // Focus stays in the menu: Up/Down walk the list, Left/Right stay put.
        const nth = (n: number) => `[data-menu-items] button:nth-child(${n})`;
        b.dataset.navUp = nth(Math.max(1, i));
        b.dataset.navDown = nth(Math.min(all.length, i + 2));
        b.dataset.navLeft = b.dataset.navRight = nth(i + 1);
        b.addEventListener('click', () => { closeMenu(); if (i < all.length - 1) say(text.done); });
        return b;
      }));
      menu.hidden = false;
      $<HTMLElement>('[data-menu-items] button').focus({ preventScroll: true });
    };

    // OK opens (a toast here); holding OK (or a right-click / long press) opens the menu.
    let holdTimer = 0;
    let held = false;
    stage.addEventListener('keydown', (e) => {
      const tile = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      if (!tile || e.key !== 'Enter') return;
      e.preventDefault();
      if (e.repeat) return;
      held = false;
      holdTimer = window.setTimeout(() => { held = true; openMenu(tile); }, 600);
    });
    stage.addEventListener('keyup', (e) => {
      const tile = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      if (e.key !== 'Enter' || !holdTimer) return;
      clearTimeout(holdTimer);
      holdTimer = 0;
      if (tile && !held) say(tile.dataset.toast!);
    });
    stage.addEventListener('click', (e) => {
      const tile = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      if (tile && e.detail > 0) say(tile.dataset.toast!);
    });
    stage.addEventListener('contextmenu', (e) => {
      const tile = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      if (!tile) return;
      e.preventDefault();
      tile.focus({ preventScroll: true });
      openMenu(tile);
    });
  }
</script>

<style>
  .back { inset-inline-start: var(--space-safe-inline); top: var(--space-safe-block); width: 72px; height: 72px; border-radius: 36px; align-items: center; justify-content: center; --rest-border: var(--color-line-soft); --rest-border-width: var(--border-chip-width); }
  :global([dir='rtl']) .back :global(svg) { transform: scaleX(-1); }
  .head { position: absolute; inset-inline-start: calc(var(--space-safe-inline) + 72px + 28px); top: var(--space-safe-block); height: 72px; display: flex; align-items: center; gap: 28px; }
  .title { font-size: var(--font-size-title-l); line-height: var(--font-line-height-display); }
  .count { font-size: var(--font-size-body); color: var(--color-mist-400); }
  .chip { inset-inline-end: var(--space-safe-inline); top: var(--space-safe-block); height: 72px; padding: 0 28px; border-radius: 36px; align-items: center; gap: 16px; color: var(--color-gold-400); font-size: var(--font-size-body); --rest-fill: transparent; --rest-border: var(--color-gold-400); --rest-border-width: 2px; }
  .chip-time { font-size: 32px; color: var(--color-plaster-100); }
  .chip:focus .chip-time { color: inherit; }

  .tile { height: 168px; padding: 22px 24px; flex-direction: column; justify-content: space-between; text-align: start; }
  .top { display: flex; justify-content: space-between; align-items: flex-start; height: 56px; }
  .mono { width: 56px; height: 56px; border-radius: 14px; background: var(--color-lapis-700); display: flex; align-items: center; justify-content: center; }
  .tile:focus .mono, :global(.tv:not(:focus-within)) .tile[data-focus-start] .mono { background: var(--color-lapis-900); color: var(--color-plaster-100); }
  .star { color: var(--color-gold-400); line-height: 0; }
  .tile:focus .star, :global(.tv:not(:focus-within)) .tile[data-focus-start] .star { color: var(--color-lapis-900); }
  .label { font-size: var(--font-size-body); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .bar { position: absolute; inset-inline-start: var(--space-safe-inline); top: 830px; width: 1728px; padding: 24px 32px; border-radius: var(--radius-tile); background: var(--color-lapis-800); display: flex; justify-content: space-between; align-items: center; }
  .who-name { font-size: var(--font-size-body-l); font-weight: 500; }
  .who-note { font-size: var(--font-size-label); color: var(--color-mist-400); margin-top: 6px; }
  .keys { display: flex; gap: 36px; font-size: var(--font-size-label); color: var(--color-mist-400); white-space: pre; }

  .menu { position: absolute; inset: 0; background: var(--color-scrim-menu); display: flex; align-items: center; justify-content: center; --spatial-navigation-contain: contain; }
  .menu[hidden] { display: none; }
  .menu-card { width: 820px; padding: 40px 48px; border-radius: var(--radius-panel); background: var(--color-lapis-800); box-shadow: inset 0 0 0 2px var(--color-gold-400-60); }
  .menu-title { font-size: 48px; line-height: 1.2; color: var(--color-gold-400); }
  .menu-items { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
  .menu-items :global(.item) { position: relative; height: 72px; padding: 0 32px; border-radius: 36px; align-items: center; font-size: var(--font-size-body); --rest-fill: var(--color-lapis-700); }

  .toast { position: absolute; inset-inline-end: var(--space-safe-inline); bottom: 270px; max-width: var(--layout-toast-width); padding: 24px 32px; border-radius: var(--radius-panel); background: var(--color-card-fill); color: var(--color-card-text); font-size: var(--font-size-body); }
  .toast[hidden] { display: none; }
</style>
